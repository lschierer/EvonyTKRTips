---
import { getCollection } from "astro:content";
import "tabulator-tables/dist/css/tabulator.css";

const generals = (await getCollection("generals")).map((entry) => entry.data);
import "@styles/generals.css";
---

<generals-table generals={JSON.stringify(generals)}></generals-table>
<div id="generals-table" class="not-content"></div>

<script>
  import {
    Tabulator,
    AccessorModule,
    ColumnCalcsModule,
    DataTreeModule,
    FilterModule,
    FormatModule,
    MutatorModule,
    ResponsiveLayoutModule,
    SortModule,
  } from "tabulator-tables";
  Tabulator.registerModule([
    AccessorModule,
    ColumnCalcsModule,
    DataTreeModule,
    FilterModule,
    FormatModule,
    MutatorModule,
    ResponsiveLayoutModule,
    SortModule,
  ]);
  import { General } from "@schemas/generals";
  import { type StoreValue } from "nanostores";

  import * as stores from "./store";
  type StoredGeneral = StoreValue<typeof stores.generals>;

  import * as generalTableFunctions from "./generalTable";

  const DEBUG = true;

  export default class GeneralsTable extends HTMLElement {
    private table: Tabulator | null = null;
    private generalStore = stores.generals;
    private selectedValues = stores.selectedValues;

    constructor() {
      super();
      this.generalStore.subscribe((value, oldValue) => {
        if (DEBUG) {
          console.log(
            `general store subscribe sees new value, now has ${value.length} generals, had ${oldValue ? oldValue.length : 0}`
          );
        }
      });
      this.populateAttributes();
      if (DEBUG) {
        console.log(
          `constructor has ${this.generalStore.get().length} generals`
        );
      }
    }

    protected populateAttributes() {
      const attributes = this.getAttributeNames();
      if (attributes.includes("generals")) {
        const g = this.getAttribute("generals");

        if (g && g.length > 0) {
          this.generalStore.set(JSON.parse(g));
        }
        if (DEBUG) {
          console.log(
            `populateAttributes has ${this.generalStore.get().length} generals`
          );
        }
      }
    }

    async connectedCallback() {
      if (this.generalStore.get().length == 0) {
        this.populateAttributes();
      }
      const tableData: TableData[] = this.generalStore.get().map((general) => {
        const td = {
          general: general,
          options: this.selectedValues.get(),
        };
        return td;
      });
      this.table = new Tabulator("#generals-table", {
        debugEventsInternal: DEBUG ? ["data-loading", "data-loaded"] : false,
        debugEventsExternal: DEBUG ? ["dataLoading", "dataLoaded"] : false,
        data: tableData,
        responsiveLayout: "collapse",
        columns: [
          {
            title: "Name",
            field: "general.id",
            width: "20vw",
            sorter: "string",
          },
          {
            title: "Attack",
            field: "general.basic_attributes.attack.base",
            sorter: "number",
            mutator: generalTableFunctions.attackMutator,
          },
          {
            title: "Toughness",
            field: "toughness",
            mutator: generalTableFunctions.toughnessMutator,
            visible: true,
          },
          {
            title: "HP",
            field: "general.basic_attributes.leadership.base",
            visible: false,
            mutator: generalTableFunctions.leadershipMutator,
            mutateLink: "toughness",
          },
          {
            title: "Defense",
            field: "general.basic_attributes.defense.base",
            visible: false,
            mutator: generalTableFunctions.defenseMutator,
            mutateLink: "toughness",
          },
        ],
      });
    }
  }
  customElements.define("generals-table", GeneralsTable);
</script>
