---
import { getCollection } from "astro:content";
import "tabulator-tables/dist/css/tabulator.css";

const generals = (await getCollection("generals")).map((entry) => entry.data);
const skillbooks = (await getCollection("skillBooks")).map(
  (entry) => entry.data
);
import "@styles/generals.css";
import ValueSelector from "./valueselctor.astro";
---

<div class="not-content">
  <ValueSelector />

  <generals-table
    generals={JSON.stringify(generals)}
    skill-books={JSON.stringify(skillbooks)}></generals-table>
  <div id="generals-table" class="not-content"></div>
</div>

<script>
  import { General } from "@schemas/generals";
  import { type StoreValue, listenKeys } from "nanostores";
  import { Tabulator } from "tabulator-tables";

  import * as stores from "./store";
  type StoredGeneral = StoreValue<typeof stores.generals>;

  import * as generalTableFunctions from "./generalTable";
  import type { TableData } from "./generalTable";

  const DEBUG = true;

  export default class GeneralsTable extends HTMLElement {
    private table: Tabulator | null = null;
    private generalStore = stores.generals;
    private selectedValues = stores.selectedValues;
    private skillbooks = stores.skillBooks;

    constructor() {
      super();
      this.generalStore.subscribe((value, oldValue) => {
        if (DEBUG) {
          console.log(
            `general store subscribe sees new value, now has ${value.length} generals, had ${oldValue ? oldValue.length : 0}`
          );
        }
      });
      this.populateAttributes();
      if (DEBUG) {
        console.log(
          `constructor has ${this.generalStore.get().length} generals`
        );
      }
      this.skillbooks.subscribe((value, oldValue) => {
        if (DEBUG) {
          console.log(`skillbook store now has ${value.length} skillbooks`);
        }
      });
      listenKeys(
        this.selectedValues,
        ["level", "type", "ascending", "stars"],
        (value, oldValue, changed) => {
          if (this.table) {
            const rowCount = this.table.getDataCount();
            if (DEBUG) {
              console.log(`I now have ${rowCount} rows`);
            }
          }
        }
      );
    }

    protected populateAttributes() {
      const attributes = this.getAttributeNames();
      if (attributes.includes("generals")) {
        const g = this.getAttribute("generals");

        if (g && g.length > 0) {
          this.generalStore.set(JSON.parse(g));
        }
        if (DEBUG) {
          console.log(
            `populateAttributes has ${this.generalStore.get().length} generals`
          );
        }
      }
      if (attributes.includes("skill-books")) {
        const sb = this.getAttribute("skill-books");
        if (sb) {
          this.skillbooks.set(JSON.parse(sb));
        }
      } else {
        if (DEBUG) {
          console.log(`no skillbooks provided to GeneralsTable`);
        }
      }
    }

    async connectedCallback() {
      if (this.generalStore.get().length == 0) {
        this.populateAttributes();
      }
      this.table = generalTableFunctions.defineTable();
    }
  }
  customElements.define("generals-table", GeneralsTable);
</script>
