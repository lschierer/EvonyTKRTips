---
import { getCollection } from "astro:content";
import "tabulator-tables/dist/css/tabulator.css";

const DEBUG = true;

const generals = (await getCollection("generals")).map((entry) => entry.data);
if (DEBUG) {
  generals.sort((a, b) => {
    return a.id.localeCompare(b.id);
  }).length = 16;
}
const skillbooks = (await getCollection("skillBooks")).map(
  (entry) => entry.data
);
const conflictGroups = (await getCollection("conflictGroups")).map(
  (entry) => entry.data
);
const ascending = (await getCollection("ascending")).map((entry) => entry.data);

const specialities = (await getCollection("specialities")).map(
  (entry) => entry.data
);
---

<div class="not-content">
  <value-selector></value-selector>

  <div id="generals-table" class="not-content">
    <table-element
      generals={JSON.stringify(generals)}
      skillbooks={JSON.stringify(skillbooks)}
      conflictGroups={JSON.stringify(conflictGroups)}
      specialities={JSON.stringify(specialities)}
      ascending={JSON.stringify(ascending)}></table-element>
  </div>
</div>

<script>
  import ValueSelector from "./ValueSelector.ts";
  import TableElement from "./generalTable.ts";
</script>
