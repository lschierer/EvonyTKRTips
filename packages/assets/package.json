{
  "name": "@evonytkrtips/assets",
  "version": "1.0.2",
  "description": "Assets package for EvonyTKRTips monorepo",
  "type": "module",
  "author": "Luke Schierer",
  "license": "ISC",
  "exports": {
    ".": {
      "types": "./dist/collections/index.d.ts",
      "import": "./dist/collections/index.js"
    },
    "./collections/generals": {
      "types": "./dist/collections/generals/collection.d.ts",
      "import": "./dist/collections/generals/collection.js"
    },
    "./collections/generalConflictGroups": {
      "types": "./dist/collections/generalConflictGroups/collection.d.ts",
      "import": "./dist/collections/generalConflictGroups/collection.js"
    },
    "./collections/covenants": {
      "types": "./dist/collections/covenants/collection.d.ts",
      "import": "./dist/collections/covenants/collection.js"
    },
    "./collections/specialities": {
      "types": "./dist/collections/specialities/collection.d.ts",
      "import": "./dist/collections/specialities/collection.js"
    },
    "./collections/art": {
      "types": "./dist/collections/art/collection.d.ts",
      "import": "./dist/collections/art/collection.js"
    },
    "./collections/skillBooks": {
      "types": "./dist/collections/skillBooks/collection.d.ts",
      "import": "./dist/collections/skillBooks/collection.js"
    },
    "./collections/ascendingAttributes": {
      "types": "./dist/collections/ascendingAttributes/collection.d.ts",
      "import": "./dist/collections/ascendingAttributes/collection.js"
    },
    "./collections/blazons": {
      "types": "./dist/collections/blazons/collection.d.ts",
      "import": "./dist/collections/blazons/collection.js"
    },
    "./collections/buff": {
      "types": "./dist/collections/buff/collection.d.ts",
      "import": "./dist/collections/buff/collection.js"
    },
    "./collections/specialities/*.json": "./dist/collections/specialities/*.json",
    "./collections/generals/*.json": "./dist/collections/generals/*.json",
    "./collections/generalConflictGroups/*.json": "./dist/collections/generalConflictGroups/*.json",
    "./collections/covenants/*.json": "./dist/collections/covenants/*.json",
    "./collections/art/*.json": "./dist/collections/art/*.json",
    "./collections/skillBooks/*.json": "./dist/collections/skillBooks/*.json",
    "./collections/ascendingAttributes/*.json": "./dist/collections/ascendingAttributes/*.json",
    "./collections/blazons/*.json": "./dist/collections/blazons/*.json",
    "./collections/buff/*.json": "./dist/collections/buff/*.json",
    "./styles/*.css": "./dist/styles/*.css",
    "./styles/*": "./dist/styles/*",
    "./*.css": "./dist/*.css",
    "./*.html": "./dist/*.html",
    "./*.md": "./dist/*.md"
  },
  "files": [
    "dist/**/*.html",
    "dist/**/*.md",
    "dist/**/*.svg",
    "dist/**/*.css",
    "dist/**/*.json",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build:css": "rimraf ./dist/styles ; mkdir -p ./dist/styles ; tsx ./src/scripts/build-css.ts ./dist/styles/",
    "build": "pnpm build:css && node ./build.js"
  },
  "dependencies": {
    "@spectrum-css/actionbutton": "^7.1.3",
    "@spectrum-css/alertbanner": "^3.1.1",
    "@spectrum-css/button": "^14.1.6",
    "@spectrum-css/card": "^11.1.0",
    "@spectrum-css/divider": "^5.1.0",
    "@spectrum-css/icon": "^9.1.0",
    "@spectrum-css/link": "^7.1.0",
    "@spectrum-css/menu": "^9.2.0",
    "@spectrum-css/page": "^9.1.0",
    "@spectrum-css/picker": "^9.1.4",
    "@spectrum-css/sidenav": "^7.1.0",
    "@spectrum-css/splitview": "^7.1.0",
    "@spectrum-css/table": "^8.1.0",
    "@spectrum-css/tokens": "^16.0.1",
    "@spectrum-css/typography": "^8.1.0",
    "@spectrum-web-components/styles": "^1.5.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.6",
    "js-yaml": "^4.1.0",
    "postcss": "^8.5.3",
    "postcss-extend": "^1.0.5",
    "postcss-load-config": "^6.0.1",
    "postcss-nesting": "^13.0.1",
    "postcss-preset-env": "^10.1.6",
    "postcss-reporter": "^7.1.0",
    "postcss-sorting": "^9.1.0",
    "quicktype": "^23.0.175",
    "rimraf": "^5.0.10",
    "stylelint": "^16.19.1",
    "stylelint-config-standard": "^38.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.3",
    "@types/postcss-import": "^14.0.3",
    "@types/postcss-sorting": "^8.0.2",
    "esbuild": "^0.25.3",
    "glob": "^11.0.2",
    "jiti": "^2.4.2",
    "postcss-cli": "^11.0.1",
    "zod": "^3.24.3"
  }
}
